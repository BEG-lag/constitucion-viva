{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "text.schema.json",
  "title": "text/<article>.json: every version of one article since 2006, as word-level diff operations",
  "type": "object",
  "required": ["id", "versions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{1,3}$" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "decrees", "words", "added", "removed", "ops"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "decrees": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "Decrees of the window that touched this article; empty means an editorial change." },
          "words": { "type": "integer", "minimum": 0 },
          "added": { "type": "integer", "minimum": 0 },
          "removed": { "type": "integer", "minimum": 0 },
          "ops": {
            "type": "array",
            "description": "[0, n] keep n characters of the previous version; [1, text] insert; [-1, text] delete. The first version is a single insert.",
            "items": {
              "oneOf": [
                { "type": "array", "items": [{ "const": 0 }, { "type": "integer", "minimum": 0 }], "minItems": 2, "maxItems": 2 },
                { "type": "array", "items": [{ "enum": [1, -1] }, { "type": "string" }], "minItems": 2, "maxItems": 2 }
              ]
            }
          }
        }
      }
    }
  }
}
