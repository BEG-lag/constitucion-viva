{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.schema.json",
  "title": "meta.json: sources, retrieval dates and cross-checks of the build",
  "type": "object",
  "required": ["generated", "leyesMx", "sources", "checks"],
  "additionalProperties": false,
  "properties": {
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "leyesMx": {
      "type": "object",
      "required": ["repo", "commit", "date"],
      "additionalProperties": false,
      "properties": { "repo": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "retrieved", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "checks": { "type": "object" }
  }
}
