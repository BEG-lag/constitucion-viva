{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "growth.schema.json",
  "title": "growth.json: words in articles 1 to 136 per version of the Constitution (leyes-mx), plus the 1917 estimate",
  "type": "object",
  "required": ["coverage", "original", "versions"],
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "type": "object",
      "required": ["from", "to", "versions"],
      "additionalProperties": false,
      "properties": { "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "versions": { "type": "integer", "minimum": 1 } }
    },
    "original": {
      "type": "object",
      "required": ["date", "words", "estimate"],
      "additionalProperties": false,
      "properties": { "date": { "const": "1917-02-05" }, "words": { "type": "integer", "minimum": 1 }, "estimate": { "const": true } }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "commit", "decrees", "words", "added", "removed", "editorialAdded", "editorialRemoved", "changed"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "DOF date of the leyes-mx commit." },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{7}$" },
          "decrees": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "Decrees published since the previous version." },
          "words": { "type": "integer", "minimum": 0 },
          "added": { "type": "integer", "minimum": 0, "description": "Words added in articles a decree of this window touched." },
          "removed": { "type": "integer", "minimum": 0 },
          "editorialAdded": { "type": "integer", "minimum": 0, "description": "Words added in articles changed without a decree in the window." },
          "editorialRemoved": { "type": "integer", "minimum": 0 },
          "changed": { "type": "array", "items": { "type": "string", "pattern": "^\\d{1,3}$" } }
        }
      }
    }
  }
}
